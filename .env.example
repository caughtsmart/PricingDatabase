# Populated automatically by `shopify app dev`. Copy to .env for manual runs.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel-url.trycloudflare.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders

# Local development uses SQLite; production should point at Postgres, e.g.
#   postgresql://user:password@host:5432/marginlens?schema=public
DATABASE_URL="file:./dev.sqlite"

# Optional: restrict the app to a single shop while developing.
SHOP_CUSTOM_DOMAIN=

# Billing (Shopify App Pricing). Plans are configured in the Partner Dashboard,
# not here. Leave BILLING_ENFORCED unset while the app is free or while you are
# still setting plans up — turning it on before plans exist redirects merchants
# to a plan page that has nothing on it.
BILLING_ENFORCED=false

# Only needed if the app's handle differs from "margin-lens" in shopify.app.toml
# (for example a separate staging app). It forms part of the plan page URL.
SHOPIFY_APP_HANDLE=

# Background sync. The web process runs the job worker itself by default, which
# is the right setup until ingestion starts competing with request latency. To
# split them, set this to false on the web process and run `npm run worker`.
RUN_WORKER_IN_PROCESS=true

# How long a single ingest job may run before pg-boss reclaims it. Raise this if
# you have a very large catalogue.
SYNC_JOB_TIMEOUT_SECONDS=900

# Connections the job queue opens, separate from Prisma's pool. Keep it small:
# managed Postgres connection limits are usually the first ceiling you hit.
QUEUE_POOL_SIZE=2

# --- Error monitoring -------------------------------------------------------
# Logs are structured JSON in production and human-readable elsewhere. Access
# tokens and other secrets are redacted before anything is written.
LOG_LEVEL=info

# Optional. Without a DSN the app runs on structured logs alone; with one,
# errors are also reported to Sentry.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# An uncaught exception leaves the process in an undefined state, so it exits
# and lets the platform restart it. Set false only if your host cannot restart.
UNCAUGHT_EXCEPTION_EXIT=true
