generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shopify OAuth sessions, managed by @shopify/shopify-app-session-storage-prisma.
/// The shape of this model is dictated by that package — do not rename fields.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  @@index([shop])
}

/// Per-shop configuration. One row per installed shop.
model ShopSettings {
  shop String @id

  currencyCode String @default("GBP")

  /// True when displayed prices already include tax (the norm in the UK/EU).
  /// Drives whether the engine divides tax out before computing margin.
  pricesIncludeTax Boolean @default(true)
  taxRatePct       Decimal @default(20) @db.Decimal(6, 3)

  /// Margin thresholds, in percentage points of net revenue.
  targetMarginPct   Decimal @default(35) @db.Decimal(6, 3)
  warnMarginPct     Decimal @default(20) @db.Decimal(6, 3)
  criticalMarginPct Decimal @default(10) @db.Decimal(6, 3)

  /// Average units per order. Divides FIXED_PER_ORDER cost rules so a
  /// per-order charge lands fairly on each unit. 1 is the safe default:
  /// per-order costs then behave like per-unit costs rather than vanishing.
  avgUnitsPerOrder Decimal @default(1) @db.Decimal(8, 2)

  /// Set once the default cost rules have been seeded, so we never re-seed
  /// over a merchant who has deliberately deleted them.
  defaultsSeeded Boolean @default(false)

  /// Progressive disclosure level (MARGIN-MODEL.md §4): 1 "Am I losing
  /// money?", 2 "The real number", 3 "Full unit economics". Controls what the
  /// widget shows by default, never what exists — hidden costs still count.
  /// New installs start at 1; the migration set existing shops to 3 so nobody
  /// opened the app one morning to find their detail gone.
  disclosureLevel Int @default(1)

  /// Whether the nightly background sync runs for this shop. The hour it runs
  /// at is derived from the shop domain rather than stored — see autosync.ts.
  autoSyncEnabled Boolean @default(true)

  /// Set when the merchant has confirmed the detected tax setup.
  ///
  /// Until then the dashboard warns that margins are provisional: getting
  /// `pricesIncludeTax` or the rate wrong shifts every margin in the shop, and
  /// it does so without any visible symptom.
  onboardedAt DateTime?

  /// The shop's country at install, kept so the settings page can explain where
  /// the suggested tax rate came from.
  detectedCountryCode String?
  /// True when prices include tax but no rate could be inferred — the one case
  /// where the merchant must intervene before the numbers mean anything.
  needsRateConfirmation Boolean @default(false)

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costRules CostRule[]
}

enum CostRuleKind {
  /// A percentage of net (tax-exclusive) revenue, e.g. a payment processing fee.
  PERCENT_OF_REVENUE
  /// A flat amount per unit sold, e.g. pick-and-pack labour.
  FIXED_PER_UNIT
  /// A percentage of landed unit cost, e.g. import duty.
  PERCENT_OF_COST
  /// A flat amount per order, spread across the average basket, e.g. courier.
  FIXED_PER_ORDER
  /// A write-off rate times landed cost, e.g. returns, breakage, shrinkage.
  RATE_TIMES_COST
  /// A holding cost per unit per day in stock, e.g. storage, cost of capital.
  PER_DAY_HELD
  /// A container summing its children — CostComponent only, never a CostRule.
  GROUP
}

/// What a percentage is a percentage *of*. Explicit, never assumed: getting
/// the base wrong is a silent 2-4% error (MARGIN-MODEL.md §2.3).
enum CostBase {
  NET_REVENUE
  GROSS_PRICE
  LANDED_COST
}

/// How much the merchant trusts a figure. Eventually drives a band on the
/// headline margin; stored from day one so history is there when it does.
enum Confidence {
  KNOWN
  ESTIMATED
  GUESSED
}

/// Shop-wide costs that apply to every sale, on top of per-variant landed cost.
model CostRule {
  id   String @id @default(cuid())
  shop String

  name  String
  kind  CostRuleKind
  /// Percentage points for PERCENT_OF_REVENUE, currency amount for FIXED_PER_UNIT.
  value Decimal      @db.Decimal(12, 4)

  enabled   Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings ShopSettings @relation(fields: [shop], references: [shop], onDelete: Cascade)

  @@index([shop, enabled])
}

/// A cost block (MARGIN-MODEL.md §2): one row per cost a variant carries on
/// top of Shopify's unit cost. Replaces the old five-fixed-column
/// `VariantCost` — the schema that was simultaneously too detailed and not
/// detailed enough.
///
/// Shopify's own `InventoryItem.unitCost` stays the source of truth for the
/// supplier price; these rows hold everything Shopify has nowhere to put.
model CostComponent {
  id   String @id @default(cuid())
  shop String

  /// Numeric portion of the Shopify GID. A row with a variantId belongs to
  /// that variant; variantId null with a productId is a product-scoped block
  /// shared by every variant; both null with a templateId is a template row.
  variantId String?
  productId String?

  /// Set when this row belongs to a named template rather than a live
  /// product. Applying a template copies its rows; it does not link them.
  templateId String?

  /// GROUP nesting: a block is a number *or* a formula of its children. A
  /// GROUP with children sums them; a GROUP without children acts as its own
  /// collapsed value. This is what lets a forensic landed-cost breakdown sit
  /// next to a hand-waved "£1 for the rest of it".
  parentId String?

  label String
  /// Variant-level rows are constrained to FIXED_PER_UNIT, PERCENT_OF_COST
  /// and GROUP in application code; the enum is shared with CostRule.
  kind  CostRuleKind
  /// What a percentage block is measured against; ignored for fixed amounts.
  /// Defaults to the goods cost — that is what every block meant before the
  /// base became honoured, and it is the base a duty or FX block wants.
  base  CostBase @default(LANDED_COST)
  value Decimal  @db.Decimal(12, 4)

  confidence Confidence @default(ESTIMATED)
  enabled    Boolean    @default(true)
  sortOrder  Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, variantId])
  @@index([shop, productId])
  @@index([shop, templateId])
}

/// A named, reusable set of cost blocks — "Imported from EU" typed once and
/// applied to any product. Its blocks are CostComponent rows carrying this
/// template's id. Applying stamps *copies* onto the product: honest and
/// simple — editing a template never silently reprices existing products.
model CostTemplate {
  id   String @id @default(cuid())
  shop String
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Saving under an existing name overwrites that template — "update the
  /// EU import costs" is a save, not a second template.
  @@unique([shop, name])
  @@index([shop])
}

/// A cached copy of catalogue facts needed for dashboard rollups.
///
/// Aggregating across a catalogue by paging the Admin API on every dashboard
/// load would be far too slow and would burn through the rate limit, so the
/// catalogue is synced into this table and read locally.
model VariantSnapshot {
  id   String @id @default(cuid())
  shop String

  variantId String
  productId String

  productTitle String
  variantTitle String?
  sku          String?
  vendor       String?
  productType  String?
  status       String?
  imageUrl     String?

  price           Decimal  @db.Decimal(12, 4)
  compareAtPrice  Decimal? @db.Decimal(12, 4)
  /// Shopify's "Cost per item". Null when the merchant has not set one.
  unitCost        Decimal? @db.Decimal(12, 4)
  inventoryQuantity Int    @default(0)

  /// Units sold in the trailing reporting window, used for realised margin.
  unitsSold Int @default(0)

  /// The SyncRun that last wrote this row.
  ///
  /// A bulk import streams in batches, so it cannot wrap "delete everything,
  /// then insert everything" in one transaction without holding the whole
  /// catalogue in memory. Instead each row is stamped with the run that touched
  /// it, and rows left carrying an older stamp are swept at the end. The
  /// dashboard therefore never sees a half-empty catalogue.
  lastSeenSyncId String?

  syncedAt DateTime @default(now())

  @@unique([shop, variantId])
  @@index([shop, productId])
  @@index([shop, vendor])
  @@index([shop, lastSeenSyncId])
}

/// Audit trail for Shopify's mandatory privacy webhooks.
///
/// App Review asks how compliance requests are handled, and the regulations
/// give a 30-day window to act. Recording each request — and what was done
/// about it — is how that gets evidenced later.
///
/// Deliberately stores no personal data itself: only the Shopify-assigned
/// identifiers already present in the webhook, never names, emails or phones.
model ComplianceRequest {
  id   String @id @default(cuid())
  shop String

  /// "customers/data_request" | "customers/redact" | "shop/redact"
  topic String

  /// Shopify's customer id, when the topic concerns one customer.
  customerId String?
  /// Order ids named in a data request payload.
  orderIds   String?

  receivedAt  DateTime  @default(now())
  completedAt DateTime?
  /// What the app did, e.g. "no customer data held" or "purged 412 rows".
  resolution  String?

  @@index([shop, topic])
}

/// A catalogue sync, and the state machine that drives it.
///
/// Syncs run through Shopify's Bulk Operations API: the app submits a query,
/// Shopify runs it asynchronously and sends `bulk_operations/finish`, then the
/// app downloads the JSONL result. Because catalogue and orders cannot run at
/// the same time (Shopify allows one bulk query per shop), one run moves
/// through both stages in sequence:
///
///   queued -> running(catalog) -> ingesting(catalog)
///          -> running(orders)  -> ingesting(orders) -> success
///
/// Any stage can end in `error`.
model SyncRun {
  id   String @id @default(cuid())
  shop String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  /// "queued" | "running" | "ingesting" | "success" | "error" | "cancelled"
  status String @default("queued")
  /// Which half of the run is in flight: "catalog" | "orders"
  stage  String @default("catalog")

  /// The Shopify BulkOperation GID currently being awaited, used to match the
  /// finish webhook back to this run.
  bulkOperationId String?

  variantsSynced Int @default(0)
  ordersScanned  Int @default(0)
  /// Shopify's running count of objects processed, for progress display.
  objectCount    Int @default(0)

  errorMessage String?

  @@index([shop, startedAt])
  @@index([bulkOperationId])
}
