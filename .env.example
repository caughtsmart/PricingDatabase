# Populated automatically by `shopify app dev`. Copy to .env for manual runs.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-tunnel-url.trycloudflare.com
SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders

# Local development uses SQLite; production should point at Postgres, e.g.
#   postgresql://user:password@host:5432/marginlens?schema=public
DATABASE_URL="file:./dev.sqlite"

# Optional: restrict the app to a single shop while developing.
SHOP_CUSTOM_DOMAIN=

# Billing (Shopify App Pricing). Plans are configured in the Partner Dashboard,
# not here. Leave BILLING_ENFORCED unset while the app is free or while you are
# still setting plans up — turning it on before plans exist redirects merchants
# to a plan page that has nothing on it.
BILLING_ENFORCED=false

# Only needed if the app's handle differs from "margin-lens" in shopify.app.toml
# (for example a separate staging app). It forms part of the plan page URL.
SHOPIFY_APP_HANDLE=
