{
  "name": "margin-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit && tsc --noEmit -p extensions/margin-block",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "setup": "prisma generate && prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/fs-routes": "^7.18.2",
    "@react-router/node": "^7.18.2",
    "@react-router/serve": "^7.18.2",
    "@shopify/polaris-types": "^1.0.7",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.1",
    "isbot": "^5.1.31",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.2",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  },
  "workspaces": [
    "extensions/*"
  ]
}
